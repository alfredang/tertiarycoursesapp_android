<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch window (light); values-night holds the dark one. Compose then applies the account's
         saved appearance (System / Light / Dark) with its own colour schemes. -->
    <style name="Theme.TertiaryCourses" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q" xmlns:tools="http://schemas.android.com/tools">false</item>
    </style>
</resources>
